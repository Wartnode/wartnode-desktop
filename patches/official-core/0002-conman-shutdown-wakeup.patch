+void Conman::close_wakeup()
+{
+    std::unique_lock<std::mutex> lock(mutex);
+    if (wakeupClosing)
+        return;
+    wakeupClosing = true;
+    uv_close((uv_handle_t*)&wakeup, close_caller);
+}
